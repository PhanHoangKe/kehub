# ── Chọn provider cho Embeddings ────────────────────────────────────────────
# Đặt EMBEDDING_PROVIDER=openai hoặc EMBEDDING_PROVIDER=google
EMBEDDING_PROVIDER=google

# ── OpenAI (dùng nếu EMBEDDING_PROVIDER=openai) ──────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Generative AI (dùng nếu EMBEDDING_PROVIDER=google) ───────────────
# Lấy tại: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── Chọn Vector DB ────────────────────────────────────────────────────────────
# Đặt VECTOR_DB=upstash hoặc VECTOR_DB=pinecone
VECTOR_DB=upstash

# ── Upstash Vector (dùng nếu VECTOR_DB=upstash) ──────────────────────────────
# Tạo index miễn phí tại: https://console.upstash.com/vector
# Dimension: 3072 (gemini-embedding-001) hoặc 1536 (OpenAI text-embedding-3-small)
UPSTASH_VECTOR_REST_URL=https://xxx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=AXxx...

# ── Pinecone (dùng nếu VECTOR_DB=pinecone) ───────────────────────────────────
# Tạo index miễn phí tại: https://app.pinecone.io
# Dimension phải khớp với embedding model (768 hoặc 1536)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=math-tutor-cache

# ── LLM để giải bài tập (khi cache miss) ────────────────────────────────────
# Đặt LLM_PROVIDER=openai hoặc LLM_PROVIDER=google
LLM_PROVIDER=google

# Model Google: gemini-1.5-flash (nhanh/rẻ) hoặc gemini-1.5-pro (mạnh hơn)
GOOGLE_LLM_MODEL=gemini-1.5-flash

# Model OpenAI: gpt-4o-mini (rẻ) hoặc gpt-4o (mạnh hơn)
OPENAI_LLM_MODEL=gpt-4o-mini

# ── Semantic Cache Config ─────────────────────────────────────────────────────
# Ngưỡng cosine similarity để coi là cache hit (0.0 – 1.0)
# Khuyến nghị: 0.92–0.95 cho bài toán LaTeX
CACHE_SIMILARITY_THRESHOLD=0.95

# Số kết quả gần nhất cần lấy khi tìm kiếm vector (top-K)
CACHE_TOP_K=3

# ── Server ────────────────────────────────────────────────────────────────────
AI_TUTOR_PORT=3001

# ── Admin CMS (Trạm nạp kiến thức) ────────────────────────────────────────────
# Mật khẩu bảo vệ endpoint nạp dữ liệu (đặt mạnh, ít nhất 12 ký tự, hòa hợp chữ+số+ký tự đặc biệt)
# VÍ DỤ (KHÔNG dùng ví dụ này thật): MathTutor@2026!GiaSu_987#$
ADMIN_PASSWORD=@Kedeptry2004
