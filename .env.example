# Sao chép file này thành .env và điền giá trị thực
# QUAN TRỌNG: Không commit file .env lên git

# Mật khẩu đăng nhập Admin Panel
ADMIN_PASSWORD=your_strong_password_here

# Secret ngẫu nhiên để ký session token
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_secret_here

# Port server (mặc định 3000)
PORT=3000

# ── GitHub Backup (KHUYẾN NGHỊ — backup chính thay JSONBin) ──────────────────
# Không giới hạn dung lượng. Lịch sử commit = lịch sử backup vĩnh viễn.
# Tự động restore khi Render wipe ephemeral filesystem.
#
# Hướng dẫn setup (5 phút):
#  1. Tạo private repo trên GitHub (vd: username/youth-memories-backup)
#  2. Vào https://github.com/settings/tokens → New token (classic)
#     → Chọn scope "repo" (full control of private repositories) → Generate
#  3. Trên Render: vào Environment → thêm 2 biến bên dưới
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=username/youth-memories-backup
# Tùy chọn (mặc định là main):
# GITHUB_BRANCH=main
# GITHUB_FILE_PATH=data/db.json

# ── JSONBin.io — Backup phụ (optional, giới hạn 100KB trên free plan) ────────
# Vẫn hoạt động như fallback nếu GitHub chưa cấu hình.
# Đăng ký tại: https://jsonbin.io
JSONBIN_API_KEY=your_jsonbin_api_key_here
JSONBIN_BIN_ID=your_jsonbin_bin_id_here

# ── Cloudinary — Lưu ảnh/video/audio vĩnh viễn (không mất khi redeploy) ──────
# Đăng ký miễn phí tại: https://cloudinary.com/users/register_free
# Free tier: 25GB storage, 25GB bandwidth/tháng
# Sau khi đăng ký, vào Dashboard → copy 3 giá trị bên dưới:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
