# Sao chép file này thành .env và điền giá trị thực
# QUAN TRỌNG: Không commit file .env lên git

# Mật khẩu đăng nhập Admin Panel
ADMIN_PASSWORD=@Kedeptry2004

# Secret ngẫu nhiên để ký session token (dùng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_secret_here

# Port server (mặc định 3000)
PORT=3000

# ── JSONBin.io — Lưu db.json trên Cloud (backup khi redeploy) ────────────────
# Đăng ký miễn phí tại: https://jsonbin.io
# 1. Đăng nhập → vào tab "API Keys" → copy key (bắt đầu bằng $2b$10$...)
# 2. Tạo 1 Bin mới → copy Bin ID từ URL (vd: https://api.jsonbin.io/v3/b/<BIN_ID>)
JSONBIN_API_KEY=your_jsonbin_api_key_here
JSONBIN_BIN_ID=your_jsonbin_bin_id_here

# ── Cloudinary — Lưu ảnh/video/audio vĩnh viễn (không mất khi redeploy) ──────
# Đăng ký miễn phí tại: https://cloudinary.com/users/register_free
# Free tier: 25GB storage, 25GB bandwidth/tháng — quá đủ cho dự án cá nhân
# Sau khi đăng ký, vào Dashboard → copy 3 giá trị bên dưới:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
